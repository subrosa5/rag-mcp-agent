GROQ_API_KEY=your_groq_key_here
DATABASE_URL=postgresql://localhost/rag_agent

# --- переключатель бэкенда эмбеддингов/реранкинга, см. src/rag_agent/config.py ---
# false (дефолт) = self-hosted sentence-transformers, локально
# true            = Cohere API — используется в деплое на Render (память)
USE_COHERE=false
COHERE_API_KEY=

# --- только для деплоя: домен фронта, для CORS в src/rag_agent/api/app.py ---
ALLOWED_ORIGIN=

# --- только для тестов: отдельная база, тесты делают TRUNCATE (tests/integration) ---
TEST_DATABASE_URL=postgresql://localhost/rag_agent_test
