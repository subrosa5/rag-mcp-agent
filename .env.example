GROQ_API_KEY=your_groq_key_here
DATABASE_URL=postgresql://localhost/rag_agent
USE_COHERE=false
COHERE_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Optional: choose a separately evaluated reviewer, e.g. openai/gpt-oss-120b.
CRITIC_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT=20
MAX_COMPLETION_TOKENS=2048
# Cohere only. Benchmark fast/pro on your documents before changing this.
RERANKER_MODEL=rerank-v5.0-fast
# Score scales differ by model. Defaults: Cohere 0.1; local 0.0. Calibrate before production.
# MIN_RERANK_SCORE=0.1
API_KEY=
# Explicit opt-in for local/public demo only; otherwise API_KEY is required.
DEMO_MODE=false
ALLOWED_ORIGIN=http://localhost:3000
# Estimates apply to the default 20B model; override if models/pricing change.
LLM_INPUT_USD_PER_MILLION=0.075
LLM_OUTPUT_USD_PER_MILLION=0.30
# Vercel server-only envs (set in web/.env.local or hosting dashboard):
# RAG_AGENT_API_URL=https://your-backend.example
# RAG_AGENT_API_KEY=the-same-value-as-API_KEY
